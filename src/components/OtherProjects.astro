---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { SiteData } from '../data/types';
import { getMediaImage } from '../utils/media';

interface Props {
  section: SiteData['projectsSection'];
  projects: CollectionEntry<'projects'>[];
}

const { section, projects } = Astro.props;
const otherProjects = projects
  .filter((p) => !p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

{
  otherProjects.length > 0 && (
    <div class="other-block">
      <div class="other-head-wrap">
        <h3 class="other-head">{section.otherHeading}</h3>
      </div>
      <div class="other-list">
        {otherProjects.map((project) => {
          const hasMedia = project.data.media && project.data.media.length > 0;
          const primaryMedia = hasMedia ? project.data.media[0] : null;
          const isCollapsible =
            project.data.projectSlug === 'crm' ||
            project.data.projectSlug === 'legal-case' ||
            project.data.projectSlug === 'cost-calculator';

          if (isCollapsible) {
            return (
              <details class="other-collapsible">
                <summary class="other-summary-row">
                  <div class="other-sum-left">
                    <span class="lbl dim tabular">{project.data.year}</span>
                    <h4 class="other-title">{project.data.title}</h4>
                    <p class="other-tagline">{project.data.tagline}</p>
                  </div>
                </summary>
                <div class="other-collapse-body">
                  <div class="other-left">
                    <p class="other-meta lbl dim">{project.data.meta}</p>
                  </div>
                  <div class="other-right">
                    <p class="other-summary">{project.data.summary}</p>
                    <div class="tags">{project.data.tags.map((t) => <span>{t}</span>)}</div>
                    {project.data.repos.length > 0 && (
                      <div class="btns">
                        {project.data.repos.map((r) => (
                          <a href={r.url} target="_blank" rel="noopener noreferrer" class="btn quiet">{r.label}</a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </details>
            );
          }

          if (hasMedia && primaryMedia) {
            return (
              <article class="other-row has-media">
                <div class="other-text-col">
                  <div class="other-meta-line">
                    <span class="lbl dim tabular">{project.data.year}</span>
                    <span class="lbl dim">{project.data.meta}</span>
                  </div>
                  <h4 class="other-title">{project.data.title}</h4>
                  <p class="other-tagline">{project.data.tagline}</p>
                  <p class="other-summary">{project.data.summary}</p>
                  <div class="tags">{project.data.tags.map((t) => <span>{t}</span>)}</div>
                  {project.data.repos.length > 0 && (
                    <div class="btns">
                      {project.data.repos.map((r) => (
                        <a href={r.url} target="_blank" rel="noopener noreferrer" class="btn quiet">{r.label}</a>
                      ))}
                    </div>
                  )}
                </div>

                <div class="other-media-col">
                  <figure class="other-photo">
                    <Image
                      src={getMediaImage(primaryMedia.src)}
                      alt={primaryMedia.alt}
                      widths={[480, 880, 1200]}
                      sizes="(max-width: 880px) 100vw, 880px"
                      loading="lazy"
                    />
                    <figcaption>
                      <span class="lbl">{primaryMedia.captionTitle}</span>
                      {primaryMedia.captionSub && (
                        <span class="lbl sub-cap">{primaryMedia.captionSub}</span>
                      )}
                    </figcaption>
                  </figure>
                </div>
              </article>
            );
          }

          return (
            <article class="other-row no-media">
              <div class="other-left">
                <span class="lbl dim tabular">{project.data.year}</span>
                <h4 class="other-title">{project.data.title}</h4>
                <p class="other-tagline">{project.data.tagline}</p>
                <p class="other-meta lbl dim">{project.data.meta}</p>
              </div>
              <div class="other-right">
                <p class="other-summary">{project.data.summary}</p>
                <div class="tags">{project.data.tags.map((t) => <span>{t}</span>)}</div>
                {project.data.repos.length > 0 && (
                  <div class="btns">
                    {project.data.repos.map((r) => (
                      <a href={r.url} target="_blank" rel="noopener noreferrer" class="btn quiet">{r.label}</a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )
}

<style>
  .other-block { margin-top: clamp(64px, 7vw, 96px); }
  .other-head-wrap { margin-bottom: clamp(24px, 3vw, 36px); }
  .other-head {
    font: 700 clamp(28px, 3.2vw, 40px)/1 var(--cond);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--star);
    margin: 0;
  }
  .other-list { border-top: 1px solid var(--gunmetal); }
  .other-row, .other-collapsible { border-bottom: 1px solid var(--gunmetal); }
  .other-row {
    padding-block: clamp(36px, 4vw, 56px);
    align-items: start;
  }
  .other-row:last-child, .other-collapsible:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .other-row.has-media {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--grid-gap);
  }
  .other-text-col {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .other-media-col { grid-column: 5 / -1; min-width: 0; }
  .other-meta-line {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: baseline;
  }
  .other-row.no-media {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--grid-gap);
  }
  .other-left {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .other-right {
    grid-column: 5 / -1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .other-title {
    font: 700 clamp(24px, 2.4vw, 32px)/1.08 var(--cond);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin: 0;
    color: var(--star);
  }
  .other-tagline {
    margin: 0;
    font: 600 clamp(16.5px, 1.25vw, 18px)/1.35 var(--sans);
    color: var(--star);
  }
  .other-meta { margin: 2px 0 0; }
  .other-summary {
    margin: 0;
    color: var(--soft);
    font-size: clamp(16.5px, 1.25vw, 18.5px);
    line-height: 1.65;
    max-width: 66ch;
  }
  .other-photo {
    margin: 0;
    position: relative;
    border: 1px solid var(--gunmetal);
    background: var(--void);
    overflow: hidden;
  }
  .other-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .other-photo figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24px 14px 10px;
    background: linear-gradient(to bottom, rgba(0,0,0,0), rgba(0,0,0,0.88));
  }
  .other-photo figcaption .lbl { display: block; color: var(--star); }
  .sub-cap { margin-top: 2px; color: var(--soft); }

  /* Collapsible rows */
  .other-collapsible summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    min-height: 64px;
    padding-block: clamp(20px, 2.5vw, 28px);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--grid-gap);
    align-items: center;
  }
  .other-collapsible summary::-webkit-details-marker { display: none; }
  .other-collapsible summary:hover {
    background: rgba(240, 240, 250, 0.04);
  }
  .other-collapsible summary:focus-visible {
    outline: 1px solid var(--star);
    outline-offset: -1px;
  }
  .other-collapsible summary::after {
    content: '+';
    grid-column: 12;
    justify-self: end;
    font: 300 24px/1 var(--sans);
    color: var(--dim);
  }
  .other-collapsible[open] > summary::after { content: '−'; }
  .other-sum-left {
    grid-column: 1 / 5;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .other-collapse-body {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--grid-gap);
    align-items: start;
    padding-bottom: clamp(32px, 3.5vw, 48px);
    padding-top: 6px;
  }

  @media (max-width: 880px) {
    .other-row.has-media,
    .other-row.no-media,
    .other-collapse-body {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .other-text-col, .other-media-col, .other-left, .other-right {
      grid-column: auto;
    }
    .other-collapsible summary {
      display: flex;
      justify-content: space-between;
      gap: 16px;
    }
    .other-sum-left { grid-column: auto; }
  }
</style>
